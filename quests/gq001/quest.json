      "gq001_01_obj_meet_patch": {
        "phase_id": "gq001_01",
        "id": "gq001_01_obj_meet_patch",
        "text": "Meet Patch at the bridge.",
        "localization_key": "gl_gq001_01_objective_meet_patch",
        "description": "Patch is waiting with the details of a quiet job. Hear him out.",
        "description_id": "gq001_01_desc_meet_patch",
        "description_key": "gl_gq001_01_description_meet_patch",
        "mappins": {
          "gq001_01_qmp_patch_bridge": {
            "id": "gq001_01_qmp_patch_bridge",
            "ref": "@locations.gq001_01_mp_patch_bridge.ref",
            "text": "Patch's meeting point",
            "localization_key": "gl_gq001_01_mappin_patch_bridge",
            "debug_caption": "gl_gq001_01_mappin_patch_bridge"
          }
        }
      },
      "gq001_02_obj_reach_cache": {
        "phase_id": "gq001_02",
        "id": "gq001_02_obj_reach_cache",
        "text": "Go to the cache coordinates.",
        "localization_key": "gl_gq001_02_objective_reach_cache",
        "description": "Patch gave you the first cache location. Get there and see what is waiting.",
        "description_id": "gq001_02_desc_reach_cache",
        "description_key": "gl_gq001_02_description_reach_cache",
        "mappins": {
          "gq001_02_qmp_cache": {
            "id": "gq001_02_qmp_cache",
            "ref": "@locations.gq001_02_mp_cache.ref",
            "text": "Cache coordinates",
            "localization_key": "gl_gq001_02_mappin_cache",
            "debug_caption": "gl_gq001_02_mappin_cache"
          }
        }
      },
      "gq001_02_obj_extract_cache": {
        "phase_id": "gq001_02",
        "id": "gq001_02_obj_extract_cache",
        "text": "Extract the datacache.",
        "localization_key": "gl_gq001_02_objective_extract_cache",
        "description": "Connect to the relay and breach its access point. The Tyger Claws do not need to be dead, but they will not make it easy.",
        "description_id": "gq001_02_desc_extract_cache",
        "description_key": "gl_gq001_02_description_extract_cache",
        "mappins": {
          "gq001_02_qmp_extract_cache": {
            "id": "gq001_02_qmp_extract_cache",
            "ref": "@locations.gq001_02_ap_cache.ref",
            "text": "Cache coordinates",
            "localization_key": "gl_gq001_02_mappin_cache",
            "debug_caption": "gl_gq001_02_mappin_cache"
          }
        }
      },
      "gq001_02_obj_leave_area": {
        "phase_id": "gq001_02",
        "id": "gq001_02_obj_leave_area",
        "text": "Leave the relay area.",
        "localization_key": "gl_gq001_02_objective_leave_area",
        "description": "You have the datacache. Put some distance between yourself and the relay before the Tyger Claws regroup.",
        "description_id": "gq001_02_desc_leave_area",
        "description_key": "gl_gq001_02_description_leave_area",
        "mappins": {}
      },
      "gq001_03_obj_meet_iris": {
        "phase_id": "gq001_03",
        "id": "gq001_03_obj_meet_iris",
        "text": "Meet Iris.",
        "localization_key": "gl_gq001_03_objective_meet_iris",
        "description": "Iris can make sense of the recovered cache. Bring it to her.",
        "description_id": "gq001_03_desc_meet_iris",
        "description_key": "gl_gq001_03_description_meet_iris",
        "mappins": {
          "gq001_03_qmp_iris": {
            "id": "gq001_03_qmp_iris",
            "ref": "@locations.gq001_03_mp_iris.ref",
            "text": "Iris",
            "localization_key": "gl_gq001_03_mappin_iris",
            "debug_caption": "gl_gq001_03_mappin_iris"
          }
        }
      },
      "gq001_04_obj_deliver_cache": {
        "phase_id": "gq001_04",
        "id": "gq001_04_obj_deliver_cache",
        "text": "Deliver the datacache to the drop point.",
        "localization_key": "gl_gq001_04_objective_deliver_cache",
        "description": "Take the datacache to Ghostline's drop point in Kabuki and deposit it.",
        "description_id": "gq001_04_desc_deliver_cache",
        "description_key": "gl_gq001_04_description_deliver_cache",
        "mappins": {
          "gq001_04_qmp_drop_point": {
            "id": "gq001_04_qmp_drop_point",
            "ref": "@locations.gq001_03_mp_drop_point.ref",
            "text": "Drop point",
            "localization_key": "gl_gq001_04_mappin_drop_point",
            "debug_caption": "gl_gq001_04_mappin_drop_point"
          }
        }
      }
